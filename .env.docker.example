# Nom de domaine sans https:// ni chemin
PHX_HOST=pronotex.example.net
# Générer avec : mix phx.gen.secret
SECRET_KEY_BASE=

# SQLite : le compose monte DATA_DIR (défini dans .env) sur /app/data.
DATABASE_PATH=/app/data/pronotex.db

# Agenda, notes et messages relus toutes les 5 minutes, même sans navigateur.
PRONOTE_BACKGROUND_REFRESH=true

# URL de base HTTPS, sans parent.html ni eleve.html
PRONOTE_URL=https://mon-college.index-education.net/pronote/

# Profil Famille : identifiants du compte parent, PIN applicatif de 8 chiffres
PRONOTE_FAMILY_USERNAME=
PRONOTE_FAMILY_PASSWORD=
PRONOTE_FAMILY_PIN_CODE=

# Profils parents facultatifs : répéter avec PARENT_2, PARENT_3, etc.
PRONOTE_PARENT_1_FIRST_NAME=
PRONOTE_PARENT_1_USERNAME=
PRONOTE_PARENT_1_PASSWORD=
PRONOTE_PARENT_1_PIN_CODE=

# Prénom exact PRONOTE ; répéter avec CHILD_2, CHILD_3, etc.
# Sans PIN, les identifiants élève restent utilisables depuis Famille/Parent,
# mais aucune connexion individuelle n’est proposée à cet enfant.
PRONOTE_CHILD_1_FIRST_NAME=Alice
PRONOTE_CHILD_1_USERNAME=
PRONOTE_CHILD_1_PASSWORD=
PRONOTE_CHILD_1_PIN_CODE=
PRONOTE_CHILD_1_THEME=blue
# PNG, JPEG ou WebP encodé en Base64 brut
PRONOTE_CHILD_1_AVATAR_BASE64=
