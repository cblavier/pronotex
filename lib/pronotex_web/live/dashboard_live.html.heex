<Layouts.app flash={@flash} child_theme={child_theme(@children, @child)}>
  <PronotexWeb.AppHeader.header
    account={@account}
    children={@children}
    child={@child}
    section={@section}
    loading={@loading}
    current_url={@current_url}
    today={@today}
    notifications={@notifications}
    messages_unread={@messages_unread}
    parent_messages_unread={@parent_messages_unread}
    homework_badge_count={@homework_badge_count}
  >
    <.week_selector
      :if={@section not in ["notes", "messages", "parent-messages", "settings"]}
      id="date-navigation"
      show_cycle={@section == "timetable"}
      cycle={if @child, do: Map.get(@child, :week_cycles, %{})[Date.beginning_of_week(@week)]}
      class="my-4 ml-auto"
      week={if @week_overview, do: @week_overview_start, else: @week}
      mode={if @week_overview, do: :week, else: @mode}
      loading={@loading || (@week_overview && @week_overview_loading)}
      today_active={
        if @week_overview,
          do: @week_overview_start == timetable_today(@today),
          else: @mode == :today
      }
      week_event={if @week_overview, do: "overview-week", else: "week"}
      today_event={if @week_overview, do: "overview-today", else: "today"}
    />
    <form
      :if={@section == "notes" && @grade_periods != []}
      class="my-4 ml-auto"
      id="grade-period-form"
      phx-change="grade-period"
    >
      <.dropdown
        id="grade-period"
        name="period"
        label="Période"
        options={@grade_periods}
        value={@grade_period}
        disabled={@loading}
      />
    </form>
  </PronotexWeb.AppHeader.header>

  <div
    id="page-content"
    phx-hook="AgendaScroll"
    data-agenda-key={if @current_url, do: agenda_url(@current_url)}
    hidden={@loading}
    aria-busy={to_string(@loading)}
  >
    <PronotexWeb.Settings.panel :if={@section == "settings"} />
    <section
      id="grades-content"
      aria-labelledby="nav-notes"
      hidden={@section != "notes"}
      class="space-y-6"
      data-panel={@grades_panel}
    >
      <nav id="grades-subnav" aria-label="Affichage des notes">
        <button
          :for={{panel, label} <- [{"latest", "Dernières notes"}, {"averages", "Moyennes"}]}
          id={"grades-panel-#{panel}"}
          type="button"
          phx-click="grades-panel"
          phx-value-panel={panel}
          aria-pressed={to_string(@grades_panel == panel)}
          aria-controls={if panel == "latest", do: "latest-grades", else: "grade-averages"}
          disabled={@loading}
        >
          {label}
        </button>
      </nav>
      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div id="grade-averages" class="min-w-0 space-y-6">
          <div
            :if={!@loading && !@grades_error && !@error}
            class="card min-w-0 border border-base-300 bg-base-100"
          >
            <div class="card-body overall-summary gap-5 p-5 sm:p-6">
              <PronotexWeb.GradeTrendChart.chart
                points={@grade_trend}
                class_points={@class_grade_trend}
              />
              <div class="overall-summary-text space-y-3">
                <div class="flex items-baseline gap-3">
                  <h3 class="text-lg font-medium text-neutral-700 dark:text-neutral-300">
                    Moyenne générale
                  </h3>
                  <p
                    id="overall-average"
                    class="whitespace-nowrap text-3xl font-semibold text-[var(--day-ink)]"
                  >
                    <% [score | scale] =
                      String.split(mark(@overall, @overall_out_of), " / ", parts: 2) %>
                    {score}<span :for={out_of <- scale} class="text-lg font-medium"> / {out_of}</span>
                  </p>
                </div>
                <p id="class-overall-average" class="text-sm text-base-content/60">
                  Moyenne de classe : {mark(@class_overall, @overall_out_of)}
                </p>
              </div>
            </div>
          </div>
          <div class="card min-w-0 border border-base-300 bg-base-100">
            <div class="card-body gap-5 p-5 sm:p-6">
              <h3 class="card-title text-lg font-semibold">Moyennes par matière</h3>
              <.empty_state
                :if={!@loading && !@grades_error && !@error && @average_count == 0}
                id="no-averages"
                text="Aucune moyenne publiée pour cette période."
              />
              <div class="subject-averages-scroll overflow-x-auto">
                <table class="table table-sm">
                  <thead :if={@average_count > 0}>
                    <tr>
                      <th>Matière</th>
                      <th>Moyenne</th>
                      <th>Classe</th>
                      <th>Min. classe</th>
                      <th>Max. classe</th>
                    </tr>
                  </thead>
                  <tbody id="subject-averages" phx-update="stream">
                    <tr :for={{dom_id, average} <- @streams.averages} id={dom_id}>
                      <th scope="row" class="font-normal text-[var(--muted-ink)]">
                        {average.subject}
                      </th>
                      <td class="font-semibold text-[var(--day-ink)]">
                        {mark(average.score, average.out_of)}
                      </td>
                      <td>{average.average || "—"}</td>
                      <td>{average.min || "—"}</td>
                      <td>{average.max || "—"}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div id="latest-grades" class="min-w-0">
          <div class="space-y-5">
            <.empty_state
              :if={!@loading && !@grades_error && !@error && @grade_count == 0}
              id="no-grades"
              text="Aucune note publiée pour cette période."
            />
            <div id="grade-list" phx-update="stream" class="space-y-3">
              <.content_card
                :for={{dom_id, grade} <- @streams.grades}
                tag="article"
                id={dom_id}
                title_tag="h4"
                truncate_title
                data-new={to_string(Pronotex.GradeHistory.new?(grade))}
              >
                <:title><span title={grade.subject}>{grade.subject}</span></:title>
                <:title_badge :if={Pronotex.GradeHistory.new?(grade)}>
                  <span class="badge badge-sm normal-case border-0 bg-[var(--day-ink)] text-[var(--surface-background)]">
                    Nouveau
                  </span>
                </:title_badge>
                <:date>
                  <time class="text-xs" datetime={Date.to_iso8601(grade.date)}>
                    {Calendar.strftime(grade.date, "%d/%m/%Y")}
                  </time>
                </:date>
                <div class="space-y-2 px-4 py-3">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xl font-semibold text-[var(--day-ink)]">
                      {mark(grade.score, grade.out_of)}
                    </p>
                    <span :if={grade.coefficient} class="text-xs text-base-content/60">
                      Coefficient {grade.coefficient}
                    </span>
                  </div>
                  <p :if={grade.comment && grade.comment != ""}>
                    {grade.comment}
                  </p>
                  <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-base-content/60">
                    <span>Moy. classe : {grade.average || "—"}</span><span>Min. : {grade.min || "—"}</span><span>Max. : {grade.max || "—"}</span>
                    <span :if={grade.bonus} class="badge badge-soft badge-xs">Bonus</span>
                    <span :if={grade.optional} class="badge badge-soft badge-xs">Facultatif</span>
                  </div>
                </div>
              </.content_card>
            </div>
            <.show_more_button
              :if={@remaining_grades != []}
              id="show-more-grades"
              phx-click="show-more-grades"
              aria-controls="grade-list"
              disabled={@loading}
            />
          </div>
        </div>
      </div>
    </section>

    <section
      id="canteen-content"
      aria-labelledby="nav-cantine"
      hidden={@section != "cantine"}
      class="min-w-0"
    >
      <div class="space-y-5">
        <.empty_state
          :if={!@loading && !@error && !@menu_error && @menu_count == 0}
          id="no-menus"
          text="Aucun menu publié pour cette période."
        />
        <div id="menu-days" phx-update="stream" class="space-y-6">
          <.content_card
            :for={{dom_id, day} <- @streams.menu_days}
            tag="section"
            id={dom_id}
            title_tag="h3"
          >
            <:title>
              {if @mode == :today, do: relative_day(day.date, @today), else: day_label(day.date)}
            </:title>
            <article :for={menu <- day.entries} class="space-y-3 p-4">
              <p :if={menu.courses == []} class="text-sm text-base-content/60">
                Menu non détaillé.
              </p>
              <dl class="space-y-3">
                <div :for={course <- menu.courses}>
                  <dt class="text-xs font-medium text-base-content/50">{course.label}</dt>
                  <dd class="text-sm">{Enum.join(course.foods, " · ")}</dd>
                </div>
              </dl>
            </article>
          </.content_card>
        </div>
      </div>
    </section>

    <section :if={@section == "agenda" && @open_lesson} id="lesson-detail" class="space-y-4">
      <%= if lesson = Enum.find(@lessons, &(lesson_key(&1) == @open_lesson && lesson_details?(&1, @now))) do %>
        <div class="messages-header">
          <nav id="lesson-breadcrumb" aria-label="Fil d’Ariane" class="messages-breadcrumb">
            <.back_link patch={agenda_url(@current_url)} label="Retour à l’agenda" />
          </nav>
        </div>
        <.content_card class="lesson-content-card" title_tag="h2">
          <:title>{lesson.subject || "Cours"}</:title>
          <:date>
            <time datetime={Date.to_iso8601(NaiveDateTime.to_date(lesson.start))}>
              {Calendar.strftime(lesson.start, "%d/%m/%Y")}
            </time>
            <span>· {clock(lesson.start)}–{clock(lesson.end)}</span>
          </:date>
          <div class="lesson-content-body">
            <div
              :for={content <- lesson.contents}
              :if={content.title != "" || content.description != ""}
              class="lesson-content-block"
            >
              <h3 :if={content.title != ""} class="font-semibold">{content.title}</h3>
              <p
                :if={content.description != ""}
                class="lesson-content-text whitespace-pre-wrap"
                phx-no-format
              >{content.description}</p>
            </div>
            <% resources =
              lesson.contents |> Enum.flat_map(& &1.resources) |> Enum.uniq_by(& &1.url) %>
            <.resource_links resources={resources} />
          </div>
        </.content_card>
      <% else %>
        <div class="messages-header">
          <nav aria-label="Fil d’Ariane" class="messages-breadcrumb">
            <.back_link patch={agenda_url(@current_url)} label="Retour à l’agenda" />
          </nav>
        </div>
        <.empty_state id="lesson-detail-empty" text="Aucun contenu disponible pour ce cours." />
      <% end %>
    </section>

    <div id="school-content" hidden={@section not in ["agenda", "timetable", "devoirs"]}>
      <div
        id="agenda-content"
        data-panel={@agenda_panel}
        class="grid items-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]"
        hidden={@section not in ["agenda", "timetable"] || @open_lesson != nil}
        aria-labelledby="nav-agenda"
        aria-busy={to_string(@loading)}
      >
        <.week_timetable
          :if={@week_overview}
          lessons={@week_overview_lessons}
          monday={@week_overview_start}
          loading={@week_overview_loading}
          error={@week_overview_error}
          warning={@week_overview_warning}
          today={@today}
          now={@now}
          cycle={Map.get(@child, :week_cycles, %{})[@week_overview_start]}
        />
        <nav id="agenda-subnav" aria-label="Affichage de l’agenda">
          <button
            :for={{panel, label} <- [{"timetable", "Emploi du temps"}, {"events", "Évènements"}]}
            id={"agenda-panel-#{panel}"}
            type="button"
            phx-click="agenda-panel"
            phx-value-panel={panel}
            aria-pressed={to_string(@agenda_panel == panel)}
            aria-controls={if panel == "events", do: "upcoming", else: "timetable"}
            disabled={@loading}
          >
            {label}
          </button>
        </nav>
        <section id="timetable" aria-label="Emploi du temps" class="min-w-0">
          <div class="space-y-5">
            <.empty_state
              :if={!@loading && !@error && !@lesson_error && @lesson_count == 0 && @mode == :week}
              id="no-lessons"
              text="Aucun cours cette semaine."
            />
            <div id="lesson-days" phx-update="stream" class="space-y-6">
              <.content_card
                :for={{dom_id, day} <- @streams.lesson_days}
                tag="section"
                id={dom_id}
                title_tag="h3"
                data-day={Date.day_of_week(day.date)}
              >
                <:title>
                  {if @mode == :today,
                    do: relative_day(day.date, @today),
                    else: day_label(day.date)}
                  <span
                    :if={day.date == @today && @mode == :week}
                    class="badge badge-ghost badge-xs normal-case"
                  >
                    Aujourd’hui
                  </span>
                </:title>
                <:actions>
                  <.tooltip
                    :if={day.date == @first_lesson_date}
                    id="week-overview-tooltip"
                    text="Agenda semaine"
                    class="ml-auto -my-2"
                  >
                    <button
                      id="open-week-overview"
                      type="button"
                      phx-click="open-week-overview"
                      class="btn btn-sm btn-soft themed-mini-button"
                      aria-label="Voir l’emploi du temps de la semaine en plein écran"
                      aria-describedby="week-overview-tooltip"
                    >
                      <.icon name="hero-arrows-pointing-out" class="size-4" />
                    </button>
                  </.tooltip>
                </:actions>
                <.empty_state
                  :if={day.entries == []}
                  id="no-lessons-today"
                  text="Aucun cours aujourd’hui."
                />
                <div class="divide-y divide-base-200 px-4">
                  <%= for lesson <- day.entries do %>
                    <div
                      :for={pause <- lesson.pauses_before}
                      data-state={agenda_state(pause, @now)}
                      class="agenda-pause flex items-center gap-4 py-3 text-base-content/55"
                    >
                      <div class="w-12 shrink-0 text-sm tabular-nums">
                        <p>{clock(pause.start)}</p>
                        <p class="mt-1 text-xs">{clock(pause.end)}</p>
                      </div>
                      <p class="flex min-w-0 flex-1 items-center gap-1.5 pl-4 text-sm italic">
                        {pause.label}
                        <span :if={agenda_state(pause, @now) == "current"} class="sr-only">
                          En cours
                        </span>
                        <.icon :if={pause.label == "Repas"} name="utensils" class="size-4" />
                      </p>
                    </div>
                    <article
                      class={[
                        "lesson-entry flex gap-4 py-3",
                        lesson_details?(lesson, @now) && "lesson-with-content"
                      ]}
                      data-state={agenda_state(lesson, @now)}
                    >
                      <.link
                        :if={lesson_details?(lesson, @now)}
                        patch={lesson_url(@current_url, lesson_key(lesson))}
                        class="lesson-detail-link"
                      >
                        <span class="sr-only">
                          Voir le contenu du cours {lesson.subject} du {Calendar.strftime(
                            lesson.start,
                            "%d/%m/%Y à %H:%M"
                          )}
                        </span>
                      </.link>
                      <div class="w-12 shrink-0 text-sm tabular-nums">
                        <p>{clock(lesson.start)}</p>
                        <p class="mt-1 text-xs text-base-content/45">{clock(lesson.end)}</p>
                      </div>
                      <div
                        class="min-w-0 flex-1 border-l-2 border-base-300 pl-4"
                        style={if lesson.color, do: "border-left-color: #{lesson.color}"}
                      >
                        <div class="flex flex-wrap items-center gap-2">
                          <h4 class={[
                            "text-sm font-medium uppercase",
                            lesson.canceled && "text-base-content/45 line-through"
                          ]}>
                            {lesson.subject || "Cours"}
                          </h4>
                          <svg
                            :if={lesson_details?(lesson, @now) && lesson_notes?(lesson)}
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            role="img"
                            aria-label="Contenu du cours"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8l-5-5Zm0 0v5h5M9 12h6m-6 4h6"
                            />
                          </svg>
                          <svg
                            :if={lesson_details?(lesson, @now) && lesson_resources?(lesson)}
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            role="img"
                            aria-label="Ressources du cours"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="m21 11-8 8a6 6 0 0 1-8.5-8.5l8-8a4 4 0 0 1 5.7 5.7l-8 8a2 2 0 0 1-2.8-2.8l7.3-7.3"
                            />
                          </svg>
                          <span
                            :if={agenda_state(lesson, @now) == "current"}
                            class="sr-only"
                          >
                            En cours
                          </span>
                          <.lesson_badges lesson={lesson} />
                        </div>
                        <p :if={lesson.teachers != []} class="mt-1 text-xs text-base-content/55">
                          {Enum.join(lesson.teachers, ", ")}
                        </p>
                        <p :if={lesson.classrooms != []} class="mt-1 text-xs text-base-content/55">
                          {Enum.join(lesson.classrooms, ", ")}
                        </p>
                        <p
                          :if={lesson.memo}
                          class="mt-2 whitespace-pre-line text-xs text-base-content/60"
                        >
                          {lesson.memo}
                        </p>
                      </div>
                    </article>
                  <% end %>
                </div>
              </.content_card>
            </div>
          </div>
        </section>
        <.content_card
          tag="aside"
          title_tag="h2"
          title_id="upcoming-title"
          id="upcoming"
          aria-labelledby="upcoming-title"
          class="min-w-0"
        >
          <:title>
            Évènements
          </:title>
          <div class="space-y-4 px-4 pb-4">
            <.empty_state
              :if={!@loading && !@error && !@event_error && @event_count == 0}
              id="no-events"
              text="Aucun événement à venir."
            />
            <div id="upcoming-events" phx-update="stream" class="divide-y divide-base-200">
              <article
                :for={{dom_id, event} <- @streams.events}
                id={dom_id}
                class="space-y-2 py-4 last:pb-0"
                data-imminent={to_string(Pronotex.Pronote.Event.imminent?(event, @today))}
              >
                <h3 class="content-card-subtitle font-semibold text-[var(--day-ink)]">
                  {event.title}
                </h3>
                <div>
                  <p class="text-xs font-medium text-[var(--day-ink)]">{event_schedule(event)}</p>
                  <p
                    :if={event.description != ""}
                    class="whitespace-pre-line break-words text-sm text-base-content/70"
                  >
                    {event.description}
                  </p>
                </div>
              </article>
            </div>
            <.show_more_button
              :if={@remaining_events != []}
              id="show-more-events"
              phx-click="show-more-events"
              aria-controls="upcoming-events"
              disabled={@loading}
            />
          </div>
        </.content_card>
      </div>
      <div
        id="homework-content"
        hidden={@section != "devoirs"}
        aria-labelledby="nav-devoirs"
        aria-busy={to_string(@loading)}
      >
        <section id="homework" aria-label="Devoirs" class="min-w-0">
          <div class="space-y-5">
            <.empty_state
              :if={!@loading && !@error && !@homework_error && @homework_count == 0}
              id="no-homework"
              text={
                if @mode == :today,
                  do: "Aucun devoir pour les sept prochains jours.",
                  else: "Aucun devoir pour cette semaine."
              }
            />
            <div id="homework-days" phx-update="stream" class="space-y-6">
              <.content_card
                :for={{dom_id, day} <- @streams.homework_days}
                tag="section"
                id={dom_id}
                title_tag="h3"
                data-day={Date.day_of_week(day.date)}
              >
                <:title>
                  <span>
                    {if @mode == :today,
                      do: due_label(day.date, @today),
                      else: "Pour " <> String.downcase(day_label(day.date))}
                  </span>
                </:title>
                <:actions>
                  <.count_badge
                    id={"homework-count-#{day.date}"}
                    class="homework-day-count"
                    status={
                      cond do
                        Enum.all?(day.entries, & &1.done) ->
                          "done"

                        Date.compare(day.date, Pronotex.Pronote.Homework.urgent_until(@today)) !=
                            :gt ->
                          "due"

                        true ->
                          "future"
                      end
                    }
                    aria-label={"#{Enum.count(day.entries, & &1.done)} devoirs faits sur #{length(day.entries)}"}
                    count={"#{Enum.count(day.entries, & &1.done)} / #{length(day.entries)}"}
                  />
                </:actions>
                <div class="divide-y divide-base-200 px-4">
                  <article
                    :for={homework <- day.entries}
                    class="py-3"
                  >
                    <div
                      class="homework-entry min-w-0 border-l-2 border-base-300 pl-4"
                      style={if homework.color, do: "border-left-color: #{homework.color}"}
                    >
                      <div class="mb-1.5 flex items-center justify-between gap-2">
                        <h4 class={["text-sm font-medium", homework.done && "opacity-55"]}>
                          {homework.subject || "Devoir"}
                        </h4>
                        <button
                          :if={@homework_writable}
                          id={"homework-toggle-#{homework.id}"}
                          phx-click="toggle-homework"
                          phx-value-id={homework.id}
                          disabled={@homework_saving != nil || @homework_save_error != nil}
                          data-homework-status={
                            cond do
                              homework.done ->
                                "done"

                              Date.compare(
                                homework.date,
                                Pronotex.Pronote.Homework.urgent_until(@today)
                              ) != :gt ->
                                "due"

                              true ->
                                "future"
                            end
                          }
                          aria-pressed={to_string(homework.done)}
                          aria-label={
                            if homework.done,
                              do: "Marquer ce devoir non fait",
                              else: "Marquer ce devoir fait"
                          }
                          class="btn btn-sm btn-ghost gap-2 shrink-0"
                        >
                          <.icon
                            name={
                              if homework.done, do: "hero-check-circle", else: "hero-minus-circle"
                            }
                            class="size-5"
                          />
                          <%= if @homework_saving == homework.id do %>
                            <span class="loading loading-spinner loading-xs" role="status">
                              <span class="sr-only">Enregistrement en cours</span>
                            </span>
                          <% else %>
                            {if homework.done, do: "Fait", else: "À faire"}
                          <% end %>
                        </button>
                      </div>
                      <p
                        phx-no-format
                        class={[
                          "whitespace-pre-line break-words text-sm leading-relaxed text-base-content/70",
                          homework.done && "opacity-55"
                        ]}
                      >{homework.description}</p>
                      <.resource_links resources={homework.resources} />
                    </div>
                  </article>
                </div>
              </.content_card>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
  <section
    :if={@section in ["messages", "parent-messages"]}
    id="messages-content"
    aria-labelledby="messages-title"
    aria-busy={to_string(@loading || @messages_loading)}
  >
    <div
      :if={Phoenix.Flash.get(@flash, :message_sent)}
      id="message-sent"
      role="status"
      class="message-sent mb-4"
    >
      <.icon name="hero-check-circle" class="size-6 shrink-0" />
      <p>{Phoenix.Flash.get(@flash, :message_sent)}</p>
      <button
        type="button"
        class="ml-auto shrink-0 cursor-pointer"
        aria-label="Fermer la confirmation d’envoi"
        phx-click="lv:clear-flash"
        phx-value-key="message_sent"
      >
        <.icon name="hero-x-mark" class="size-5" />
      </button>
    </div>
    <div class="messages-header">
      <nav
        id="messages-breadcrumb"
        aria-label="Navigation des messages"
        class="messages-breadcrumb"
      >
        <.back_link
          :if={@open_discussion}
          patch={discussion_url(@selected_slug, @mode, @week, @grade_period, nil, @section)}
          label="Retour aux messages"
        />
        <.page_title :if={!@open_discussion} id="messages-title">
          {messages_label(@account, @child, @section)}
        </.page_title>
      </nav>
      <.link
        :if={
          !@open_discussion && @child &&
            PronotexWeb.MessageComposeLive.allowed?(@account, @section)
        }
        id="new-message"
        navigate={~p"/#{@selected_slug}/#{@section}/new"}
        class="btn btn-sm themed-mini-button new-message-button"
      >
        <.icon name="hero-pencil-square" class="size-4" /> Nouveau message
      </.link>
    </div>
    <p
      :if={
        @open_discussion && !@loading && !@messages_loading && !@messages_error &&
          @messages_available && !Enum.any?(@discussions, &(&1.id == @open_discussion))
      }
      class="messages-empty"
    >
      Cette discussion n’est plus disponible.
    </p>
    <p :if={!@loading && !@messages_available} class="messages-empty">
      Les identifiants du compte élève sont nécessaires pour consulter ses messages.
    </p>
    <p :if={@messages_loading} class="messages-empty" role="status">
      Chargement des messages…
    </p>
    <.empty_state
      :if={
        !@loading && @messages_available && !@messages_loading && !@messages_error &&
          @discussions == []
      }
      id="no-messages"
      text="Aucun message."
    />
    <div id="discussion-list" class="discussion-list">
      <article
        :for={
          discussion <-
            if(@open_discussion,
              do: Enum.filter(@discussions, &(&1.id == @open_discussion)),
              else: Enum.take(@discussions, @messages_limit)
            )
        }
        id={"discussion-#{discussion.id}"}
        class="discussion-card"
        data-kind={Map.get(discussion, :kind, :discussion)}
        data-view={if @open_discussion, do: "detail", else: "list"}
        data-unread={to_string(discussion.unread > 0)}
      >
        <.link
          :if={!@open_discussion}
          class="discussion-summary"
          patch={
            discussion_url(@selected_slug, @mode, @week, @grade_period, discussion.id, @section)
          }
        >
          <span class="discussion-heading communication-heading">
            <.communication_badge
              id={"communication-#{discussion.id}"}
              kind={Map.get(discussion, :kind, :discussion)}
            />
            <strong>{discussion.subject}</strong>
          </span>
          <span class="discussion-meta">
            <.message_correspondents message={List.last(discussion.messages, discussion)} />
            · {communication_date(discussion.date)}
          </span>
          <span :if={@open_discussion != discussion.id} class="discussion-preview">
            {discussion.preview}
          </span>
        </.link>
        <div :if={!@open_discussion} class="discussion-actions">
          <.communication_status_button
            discussion={discussion}
            saving={@message_saving}
            loading={@messages_loading}
          />
        </div>
        <.content_card_header
          :if={@open_discussion == discussion.id}
          class="communication-detail-header"
          title_tag="h2"
          title_id="messages-title"
        >
          <:title>
            <.communication_badge
              id={"communication-#{discussion.id}"}
              kind={Map.get(discussion, :kind, :discussion)}
            />
            <span class="communication-detail-subject">{discussion.subject}</span>
          </:title>
          <:actions>
            <.communication_status_button
              discussion={discussion}
              saving={@message_saving}
              loading={@messages_loading}
            />
          </:actions>
        </.content_card_header>
        <div
          :if={@open_discussion == discussion.id}
          id={"discussion-body-#{discussion.id}"}
          class="discussion-messages"
        >
          <p :if={Map.get(discussion, :kind) == :survey} class="discussion-meta">
            Pour répondre à ce sondage, utilisez Pronote.
          </p>
          <article
            :for={{entry, index} <- Enum.with_index(discussion.messages)}
            class="discussion-message"
          >
            <p class="discussion-heading">
              <.message_correspondents
                id={"correspondents-#{discussion.id}-#{index}"}
                message={entry}
                details={Map.get(discussion, :kind, :discussion) == :discussion}
              />
              <span class="discussion-meta">{communication_date(entry.date)}</span>
            </p>
            <h3 :if={Map.get(entry, :title, "") != ""}>{Map.get(entry, :title)}</h3>
            <p class="discussion-text" phx-no-format>{entry.content}</p>
            <ul :if={Map.get(entry, :choices, []) != []} class="survey-choices">
              <li :for={choice <- entry.choices}>{choice}</li>
            </ul>
            <.resource_links resources={Map.get(entry, :resources, [])} />
          </article>
        </div>
      </article>
    </div>
    <.show_more_button
      :if={!@open_discussion && length(@discussions) > @messages_limit}
      id="show-more-messages"
      phx-click="show-more-messages"
      aria-controls="discussion-list"
      disabled={@loading || @messages_loading}
    />
    <div
      :for={discussion <- Enum.filter(@discussions, &(&1.id == @open_discussion))}
      :if={
        @open_discussion == discussion.id &&
          Map.get(discussion, :kind, :discussion) == :discussion &&
          !Map.get(discussion, :closed, false) &&
          PronotexWeb.MessageComposeLive.allowed?(@account, @section)
      }
      class="message-form-actions"
    >
      <.link
        id="reply-message"
        navigate={~p"/#{@selected_slug}/#{@section}/#{discussion.id}/reply"}
        class="btn btn-sm themed-mini-button message-primary-button"
      >
        <.icon name="hero-arrow-uturn-left" class="size-4" /> Répondre
      </.link>
    </div>
  </section>
</Layouts.app>
