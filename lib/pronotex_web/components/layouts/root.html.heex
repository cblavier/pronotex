<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow, noimageindex, nosnippet" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="apple-mobile-web-app-title" content="Captain Notes" />
    <meta name="theme-color" content="#3c987f" />
    <script>
      (() => {
        const memory = {};
        const read = (key, fallback) => {
          try { return localStorage.getItem(`captain-${key}`) ?? memory[key] ?? fallback; }
          catch { return memory[key] ?? fallback; }
        };
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const theme = read("theme", "system");
          document.documentElement.dataset.theme = theme === "dark" || (theme !== "light" && media.matches) ? "dark" : "light";
          document.documentElement.style.zoom = ({small: "0.85", normal: "1", large: "1.15"})[read("zoom", "normal")] || "1";
        };
        window.captainPreferences = {read, set(key, value) {
          memory[key] = value;
          try { localStorage.setItem(`captain-${key}`, value); } catch {}
          apply();
        }};
        media.addEventListener("change", apply);
        window.addEventListener("storage", apply);
        apply();
      })();
    </script>
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={~p"/images/brand/captain-notes-skull-32.png"}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={~p"/images/brand/captain-notes-skull-180.png"}
    />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Captain Notes">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-[var(--page-background)] text-base-content antialiased">{@inner_content}</body>
</html>
