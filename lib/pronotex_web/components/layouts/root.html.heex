<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="app-version" content={PronotexWeb.DeploymentController.version()} />
    <meta name="robots" content="noindex, nofollow, noimageindex, nosnippet" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="apple-mobile-web-app-title" content="Captain Notes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#3c987f" />
    <script>
      (() => {
        const memory = {};
        const read = (key, fallback) => {
          try { return localStorage.getItem(`captain-${key}`) ?? memory[key] ?? fallback; }
          catch { return memory[key] ?? fallback; }
        };
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const theme = read("theme", "system");
          document.documentElement.dataset.theme = theme === "dark" || (theme !== "light" && media.matches) ? "dark" : "light";
          const zoom = ({small: "0.9", normal: "1", large: "1.1"})[read("zoom", "normal")] || "1";
          document.documentElement.style.zoom = zoom;
          document.documentElement.style.setProperty("--app-zoom", zoom);
        };
        window.captainPreferences = {read, set(key, value) {
          memory[key] = value;
          try { localStorage.setItem(`captain-${key}`, value); } catch {}
          apply();
        }};
        media.addEventListener("change", apply);
        window.addEventListener("storage", apply);
        apply();
      })();
    </script>
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={~p"/images/brand/pronotex-icon-32.png?v=2"}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={~p"/images/brand/pronotex-icon-180.png?v=2"}
    />
    <.startup_images />
    <script id="select-startup-image">
      (() => {
        // Resolve the device here so iOS receives one unconditional launch image.
        const anchor = document.currentScript;
        const candidates = [...document.querySelectorAll('link[rel="apple-touch-startup-image"]')]
          .map(link => ({link, query: window.matchMedia(link.media)}));
        const select = () => {
          const selected = candidates.find(candidate => candidate.query.matches);
          if (!selected) return;
          for (const {link} of candidates) {
            if (link !== selected.link) link.remove();
          }
          selected.link.removeAttribute("media");
          anchor.before(selected.link);
        };
        select();
        for (const {query} of candidates) query.addEventListener("change", select);
      })();
    </script>
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Captain Notes">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-[var(--page-background)] text-base-content antialiased">{@inner_content}</body>
</html>
