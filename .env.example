# Configuration Docker Compose (copier vers .env sur le serveur).
# Les identifiants de l'application restent dans le fichier env séparé.
# Dossier existant sur le serveur, relatif au compose ou absolu.
# DATA_DIR=. donne /volume1/docker/pronotex/pronotex.db sur le NAS actuel.
DATA_DIR=.
# Identité Unix qui peut écrire dans DATA_DIR : id -u et id -g sur le serveur.
APP_UID=1000
APP_GID=1000
DOCKER_PLATFORM=linux/amd64

# Fuseau utilisé pour la pause des rafraîchissements de 22 h à 7 h
TZ=Europe/Paris
