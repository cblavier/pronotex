# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
pronotex-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# Local credentials and direnv state (including nested directories and backups)
.env
.env.*
.envrc
.envrc.*
env
env.*
.direnv/
# Keep sanitized configuration templates versionable.
!.env.example
!.env.*.example
!.envrc.example
!env.example
!env.*.example

# Local settings and credentials
settings.local.*
config.local.*
*.local.exs
credentials.json
credentials.*.json
secrets.json
secrets.*.json
secrets.yml
secrets.yaml
/secrets/
/.secrets/

# Private keys and local certificate bundles
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
/priv/cert/

# Logs, network captures and diagnostic dumps may contain personal data
*.log
*.log.*
/logs/
*.har
*.dump
*.dmp

# Local Docker image exports
/pronotex-image.tar
/pronotex-image*.tar.gz

# Editor backups and OS metadata
*.swp
*.swo
*~
.DS_Store

# Personal avatars (local only)
/priv/static/images/avatars/
